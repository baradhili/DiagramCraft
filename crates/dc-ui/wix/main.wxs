<?xml version="1.0" encoding="windows-1252"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Fixed UpgradeCode keeps MSI upgrades working across releases;
       per-component GUID='*' derives stably from each component. -->
  <Product Id="*" Name="DiagramCraft" UpgradeCode="619c8b9c-a92f-4155-877b-cd433f65f620" Language="1033"
           Codepage="1252" Version="$(var.Version)" Manufacturer="DiagramCraft contributors">
    <Package Id="*" Keywords="Installer" Description="DiagramCraft $(var.Version) installer"
             Manufacturer="DiagramCraft contributors" InstallerVersion="200" Compressed="yes"
             InstallScope="perMachine" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of DiagramCraft is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="DiagramCraft.ico" SourceFile="wix\DiagramCraft.ico" />
    <Property Id="ARPPRODUCTICON" Value="DiagramCraft.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/baradhili/DiagramCraft" />
    <Feature Id="Binaries" Title="Application" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ProgramMenuDir" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="DiagramCraft">
          <Component Id="diagramcraft.exe" Guid="*" Win64="yes">
            <File Id="diagramcraft.exe" Name="diagramcraft.exe"
                  Source="Source\diagramcraft.exe" KeyPath="yes" />
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuDir" Name="DiagramCraft"
                      WorkingDirectory="INSTALLDIR" Advertise="yes"
                      Icon="DiagramCraft.ico" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="DiagramCraft">
          <Component Id="ProgramMenuDir" Guid="*">
            <RemoveFolder Id="ProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\DiagramCraft" Type="string"
                           Value="" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents">
      <ComponentRef Id="diagramcraft.exe" />
    </ComponentGroup>
  </Fragment>
</Wix>
